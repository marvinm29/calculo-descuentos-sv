# Puerto (opcional — default: 3001)
PORT=3001

# Host de escucha. Hardening: sólo loopback — el TLS lo termina Caddy en el mismo host.
HOST=127.0.0.1

# Entorno (opcional — default: development)
NODE_ENV=production

# Orígenes permitidos para CORS — ÚNICO punto de control CORS es Express
# (Caddy no añade headers CORS). Lista separada por comas.
# Default dev: http://localhost:5173
CORS_ORIGIN=https://marvinmelendez.engineer

# Saltos de proxy confiables para req.ip (rate limit por IP real detrás de Caddy).
# 0 o vacío = no confiar (dev directo). Producción Caddy→Express: 1.
TRUST_PROXY=1

# Sentry (opcional)
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Datadog (opcional — se configura vía env vars, no necesita código)
# DD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DD_SITE=datadoghq.com
